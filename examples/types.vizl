# Example with Typed Variables and Quotes
chart: line

# Typed variable definitions
string my_title = "Revenue " + "Forecast"
title: my_title

int base_revenue = 500
float growth_multiplier = 1.25

# Variable used in labels
string jan_label = "January"

data:
jan_label, base_revenue
"February", base_revenue * growth_multiplier
"March", base_revenue * growth_multiplier * growth_multiplier
"Final", base_revenue * 2
