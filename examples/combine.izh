// Combine arrays to create paired data
chart: scatter
title: Temperature vs Humidity

x: temperature (°C)
y: humidity (%)

// Two separate arrays combined into pairs
temps = [15, 18, 20, 22, 25, 28, 30, 32]
humidity = [45, 52, 58, 65, 72, 78, 82, 88]

// Combine them into [[15, 45], [18, 52], ..., [32, 88]]
data_points = combine(temps, humidity)

data: data_points
